{
  "name": "agentforge-cli",
  "version": "1.0.0",
  "description": "AgentForge - Autonomous AI Agent with Toolsmith Mechanism",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "agentforge": "bin/cli.cjs",
    "af": "bin/cli.cjs"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "dev": "tsx watch src/index.ts",
    "chat": "tsx src/index.ts chat",
    "tools": "tsx src/index.ts tools",
    "forge": "tsx src/index.ts forge",
    "postinstall": "echo AgentForge installed! Run 'agentforge' or 'af' to start."
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "llm",
    "openrouter",
    "toolsmith"
  ],
  "author": "AgentForge Team",
  "license": "MIT",
  "dependencies": {
    "@openrouter/sdk": "^0.1.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "boxen": "^7.1.1",
    "ora": "^8.0.1",
    "inquirer": "^9.2.12",
    "inquirer-autocomplete-prompt": "^3.0.1",
    "figlet": "^1.7.0",
    "gradient-string": "^2.0.2",
    "cli-table3": "^0.6.3",
    "marked": "^11.1.1",
    "marked-terminal": "^6.2.0",
    "conf": "^12.0.0",
    "dotenv": "^16.3.1",
    "node-fetch": "^3.3.2",
    "eventsource": "^2.0.2",
    "glob": "^10.3.10",
    "fast-glob": "^3.3.2",
    "tsx": "^4.7.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.11.16"
  }
}
