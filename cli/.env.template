# ================================================
# AgentForge Configuration
# ================================================
# Copy this to .env and fill in your values

# ================== LLM / OpenRouter ==================
# Required: Get from https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Optional: Model selection (defaults shown)
OPENROUTER_MODEL=anthropic/claude-sonnet-4-20250514
OPENROUTER_FAST_MODEL=anthropic/claude-3-haiku-20240307

# Optional: Fallback models (comma-separated)
OPENROUTER_FALLBACK_MODELS=openai/gpt-4o,anthropic/claude-3-opus-20240229

# ================== Backend Configuration ==================
# Backend API URL (for CLI connection)
BACKEND_URL=http://localhost:8000

# ================== Database (PostgreSQL with pgvector) ==================
# Required for full functionality
DATABASE_URL=postgresql://postgres:password@localhost:5432/agentforge

# ================== Redis (for caching and L1 memory) ==================
# Required for hybrid memory system
REDIS_URL=redis://localhost:6379

# ================== E2B Sandbox (for tool validation) ==================
# Optional: Get from https://e2b.dev
# If not set, tools will be validated locally
E2B_API_KEY=

# ================== Security ==================
# Rate limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=60
RATE_LIMIT_TOKENS_PER_MINUTE=100000

# Token limits per request
MAX_INPUT_TOKENS=4000
MAX_OUTPUT_TOKENS=4000

# ================== Tool Registry ==================
# PRB score thresholds (0.0 - 1.0)
PRB_MIN_THRESHOLD=0.6
PRB_WARN_THRESHOLD=0.8

# ================== Logging ==================
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ================== Development ==================
# Set to 1 to enable debug mode
DEBUG=0
