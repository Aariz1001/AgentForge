{
  "name": "agentforge",
  "version": "1.0.0",
  "description": "Autonomous AI Agent System with Self-Evolving Architecture, Dynamic Tool Generation, and Hierarchical Memory",
  "keywords": [
    "ai",
    "agent",
    "autonomous",
    "openrouter",
    "tool-generation",
    "memory",
    "self-improving",
    "cli",
    "typescript"
  ],
  "author": "AgentForge Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/agentforge.git"
  },
  "bugs": {
    "url": "https://github.com/yourusername/agentforge/issues"
  },
  "homepage": "https://github.com/yourusername/agentforge#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "main": "dist/server/index.js",
  "type": "module",
  "scripts": {
    "start:server": "tsx server/src/main.ts",
    "start:cli": "tsx cli/src/index.ts",
    "dev:server": "tsx watch server/src/main.ts",
    "dev:cli": "tsx watch cli/src/index.ts",
    "build": "tsc",
    "test": "vitest",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "agentforge": "tsx cli/src/index.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@github/copilot-sdk": "^0.1.20",
    "boxen": "^7.1.1",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "eventsource": "^2.0.2",
    "express": "^4.18.2",
    "figlet": "^1.7.0",
    "gradient-string": "^2.0.2",
    "helmet": "^7.1.0",
    "inquirer": "^9.2.14",
    "ioredis": "^5.3.2",
    "morgan": "^1.10.0",
    "node-fetch": "^3.3.2",
    "openrouter-sdk": "^1.0.9",
    "ora": "^8.0.1",
    "pg": "^8.11.3",
    "playwright": "^1.58.1",
    "puppeteer": "^24.36.1",
    "reflect-metadata": "^0.2.1",
    "sqlite3": "^5.0.2",
    "typeorm": "^0.3.6",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/figlet": "^1.5.8",
    "@types/inquirer": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.11.16",
    "@types/uuid": "^9.0.8",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3",
    "vitest": "^4.0.18"
  }
}
